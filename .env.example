# Copia questo file in .env e compila i valori:  cp .env.example .env

# --- Immagini ---
GARAGE_VERSION=v2.0.0
GARAGE_WEBUI_VERSION=latest

# --- Rete ---
# 127.0.0.1 = raggiungibile solo dalla tua macchina; 0.0.0.0 = da tutta la rete
GARAGE_BIND_ADDRESS=127.0.0.1
GARAGE_S3_PORT=3900
GARAGE_ADMIN_PORT=3903
GARAGE_WEBUI_PORT=3909

# Deve coincidere con s3_region in garage/garage.toml
GARAGE_S3_REGION=garage

# --- Segreti (da generare) ---
# openssl rand -hex 32
GARAGE_RPC_SECRET=
# openssl rand -base64 32
GARAGE_ADMIN_TOKEN=

# --- Web UI (opzionale) ---
# Lascia vuoto per nessun login. Formato "utente:hash", hash bcrypt con:
#   htpasswd -nbBC 10 "utente" "password"
# Attenzione: nel .env i "$" dell'hash vanno raddoppiati ("$$")
GARAGE_WEBUI_AUTH_USER_PASS=
