# Copia questo file in .env e compila i valori:  cp .env.example .env
# Spring lo legge dalla cartella di lavoro (storage-service/), vedi spring.config.import in application.yml.

# --- Garage (S3) ---
# Indirizzo dell'API S3 di Garage (porta GARAGE_S3_PORT del .env nella radice)
GARAGE_ENDPOINT=http://127.0.0.1:3900
# Indirizzo con cui il CLIENT raggiunge Garage: finisce negli URL firmati (l'host fa parte della firma).
# Lascialo vuoto in locale (usa GARAGE_ENDPOINT). In Docker: GARAGE_ENDPOINT=http://garage:3900 e qui l'indirizzo pubblico.
GARAGE_PUBLIC_ENDPOINT=
# Deve coincidere con s3_region in garage/garage.toml
GARAGE_S3_REGION=garage
GARAGE_BUCKET=

# Credenziali create con "garage key create" (la chiave deve avere permessi sul bucket)
GARAGE_ACCESS_KEY_ID=
GARAGE_SECRET_ACCESS_KEY=

# --- Presigned URL ---
# Durata dei link firmati, con unità: 30s, 10m, 1h (senza unità sono millisecondi)
PRESIGN_TTL=10m
